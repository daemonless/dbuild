{#- ==================================================================
    Logic — Resolve values based on render_mode (MkDocs vs GitHub)
    ================================================================== #}
{%- if render_mode == "mkdocs" %}
  {%- set reg_var = "@REGISTRY@" %}
  {%- set cfg_root = "@CONTAINER_CONFIG_ROOT@" %}
  {%- set port_var = "@" ~ name.upper().replace("-", "_") ~ "_PORT@" %}
{%- else %}
  {%- set reg_var = registry %}
  {%- set cfg_root = "/containers" %}
  {%- set port_var = ports[0].port if ports else "" %}
{%- endif -%}

{#- ==================================================================
    Macros — deployment snippets
    ================================================================== #}

{%- macro vol_src(v) -%}
{%- if v.root_var -%}
{{ cfg_root }}/{{ v.placeholder if (render_mode == "mkdocs" and v.placeholder) else v.source }}
{%- elif render_mode == "mkdocs" and v.placeholder -%}
{{ v.placeholder }}
{%- elif v.source.startswith('/') -%}
{{ v.source }}
{%- else -%}
/path/to/{{ v.source }}
{%- endif -%}
{%- endmacro -%}

{%- macro vol_tgt(v) -%}
{{ v.path }}{{ ":" ~ v.options if v.options else "" }}
{%- endmacro -%}

{%- macro compose_snippet(override_port=None) -%}
services:
  {{ name }}:
    image: "{{ reg_var }}/{{ name }}:{{ default_tag }}"
    container_name: {{ name }}
{%- if env %}
    environment:
{%- for e in env %}
      - {{ e.name }}={{ e.placeholder if (render_mode == "mkdocs" and e.placeholder) else e.default }}{{ "  # " ~ e.desc if e.desc else "" }}
{%- endfor %}
{%- endif %}
{%- if volumes %}
    volumes:
{%- for v in volumes %}
      - "{{ vol_src(v) }}:{{ vol_tgt(v) }}"{{ " # optional" if v.optional else "" }}
{%- endfor %}
{%- endif %}
{%- if ports %}
    ports:
{%- for p in ports %}
{%- if loop.first %}
      - "{{ override_port if override_port else port_var }}:{{ p.target }}"
{%- else %}
      - "{{ p.port }}:{{ p.target }}"
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if annotations %}
    annotations:
{%- for a in annotations %}
{%- set kv = a.split("=", 1) %}
      {{ kv[0] }}: "{{ kv[1] }}"
{%- endfor %}
{%- endif %}
{%- if healthcheck %}
    healthcheck:
      test: ["CMD", "{{ healthcheck }}"]
{%- endif %}
    # always (not unless-stopped) so FreeBSD's podman rc.d auto-starts it at boot
    restart: always
{%- endmacro %}

{%- macro appjail_note_expose_ports() -%}
{%- if ports %}
> [!WARNING]
> Exposing ports in AppJail means that your service can be reached from remote hosts. If that is not your intention, do not expose the ports and communicate with the service using the jail's IPv4 address or hostname assigned by the virtual network.
>
> To avoid exposing ports, just remove the `expose` option in your `appjail-director.yml` or from your command-line arguments.
{%- endif %}
{%- endmacro %}

