{%- macro cli_snippet(override_port=None) -%}
{%- if image_class == "cli" -%}
podman run --rm \
{%- else -%}
podman run -d --name {{ name }} \
{%- endif %}
{%- for p in ports %}
{%- if loop.first %}
  -p {{ override_port if override_port else port_var }}:{{ p.target }} \
{%- else %}
  -p {{ p.port }}:{{ p.target }} \
{%- endif %}
{%- endfor %}
{%- for a in annotations %}
  --annotation '{{ a }}' \
{%- endfor %}
{%- if healthcheck %}
  --health-cmd {{ healthcheck }} \
{%- endif %}
{%- for e in env %}
  -e {{ e.name }}={{ e.placeholder if (render_mode == "mkdocs" and e.placeholder) else e.default }} \
{%- endfor %}
{%- for v in volumes %}
  -v {{ vol_src(v) }}:{{ vol_tgt(v) }}{{ " # optional" if v.optional else "" }} \
{%- endfor %}
  {{ reg_var }}/{{ name }}:{{ default_tag }}
{%- endmacro %}



{%- macro bastille_compose_snippet(override_port=None) -%}
services:
  {{ name }}:
    name: {{ name }}
    image: "{{ reg_var }}/{{ name }}:{{ default_tag }}"
    network:
      - mode: host
{%- if env %}
    environment:
{%- for e in env %}
      - {{ e.name }}={{ e.placeholder if (render_mode == "mkdocs" and e.placeholder) else e.default }}
{%- endfor %}
{%- endif %}
{%- if volumes %}
    volumes:
{%- for v in volumes %}
      - "{{ vol_src(v) }}:{{ v.path }}"
{%- endfor %}
{%- endif %}
{%- endmacro %}


{#- Version-tags table, with an optional arch suffix appended to every tag
    (e.g. suffix="-aarch64" -> `15.1-aarch64`). Bare (amd64) uses suffix="". -#}
{%- macro version_tags_table(suffix='') -%}
| Tag | Description | Best For |
| :--- | :--- | :--- |
{%- if variants | length > 1 %}
{%- for v in variants %}
{%- set all_tags = ([v.tag] + v.aliases) | sort %}
{%- set tag_str = (all_tags | join(suffix ~ '` / `')) ~ suffix %}
{%- set base_ver = v.args.get('BASE_VERSION', '') %}
{%- set is_pkg = 'pkg' in v.containerfile %}
{%- if v.tag_desc %}
{%- set src_desc = v.tag_desc %}
{%- set best_for = "Most users — recommended." if v.default else "Alternative build." %}
{%- elif base_ver.endswith('-latest') %}
{%- set src_desc = "**FreeBSD Latest**. Rolling package updates." %}
{%- set best_for = "Staying current." %}
{%- elif is_pkg %}
{%- set src_desc = "**FreeBSD Quarterly**. Uses stable, tested packages." %}
{%- set best_for = "Most users — recommended." if v.default else "Production stability." %}
{%- elif upstream_binary %}
{%- set src_desc = "**Upstream Binary**. Built from official release." %}
{%- set best_for = "Most users — recommended." if v.default else "Alternative build." %}
{%- else %}
{%- set src_desc = "**FreeBSD Port**. Built from FreeBSD packages." %}
{%- set best_for = "Most users — recommended." if v.default else "Production stability." %}
{%- endif %}
| `{{ tag_str }}` | {{ src_desc }} | {{ best_for }} |
{%- endfor %}
{%- else %}
{%- set solo_desc = variants[0].tag_desc if variants else none %}
| `latest{{ suffix }}` | {% if solo_desc %}{{ solo_desc }}{% elif upstream_binary %}**Upstream Binary**. Built from official release.{% else %}**FreeBSD Port**. Built from latest FreeBSD packages.{% endif %} | Most users — recommended. |
{%- if tags and 'pkg' in tags %}
| `pkg{{ suffix }}` | **FreeBSD Quarterly**. Uses stable, tested packages. | Production stability. |
| `pkg-latest{{ suffix }}` | **FreeBSD Latest**. Rolling package updates. | Staying current. |
{%- endif %}
{%- endif %}
{%- endmacro -%}

