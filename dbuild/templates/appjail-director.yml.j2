# appjail-director.yml

options:
{%- if appjail and appjail.director and appjail.director.options %}
{%- for opt in appjail.director.options %}
{%- if opt is mapping %}
{%- for k, v in opt.items() %}
  - {{ k }}:{% if v is not none %} {{ v }}{% endif %}
{%- endfor %}
{%- else %}
  - {{ opt }}
{%- endif %}
{%- endfor %}
{%- else %}
  - virtualnet: ':<random> default'
  - nat:
{%- endif %}
services:
  {{ name }}:
    name: {{ name | replace("-", "_") }}
    options:
      - container: 'args:--pull'
{%- for p in ports %}
{%- if render_mode is defined and render_mode == "deploy" and loop.first %}
      - expose: !ENV '${WEB_PORT}:{{ p.target }} proto:{{ p.protocol }}'
{%- elif loop.first %}
      - expose: '{{ override_port if override_port else port_var }}:{{ p.target }} proto:{{ p.protocol }}'
{%- else %}
      - expose: '{{ p.port }}:{{ p.target }} proto:{{ p.protocol }}'
{%- endif %}
{%- endfor %}
{%- if appjail and appjail.makejail and appjail.makejail.options %}
{%- for opt in appjail.makejail.options %}
{%- if opt is mapping %}
{%- for k, v in opt.items() %}
      - {{ k }}: "{{ v }}"
{%- endfor %}
{%- else %}
      - {{ opt }}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if jail_allow %}
      - template: !ENV '${PWD}/template.conf'
{%- endif %}

{%- if env %}
    oci:
      user: root
      environment:
{%- for e in env %}
        - {{ e.name }}: !ENV '${{ '{' }}{{ e.name }}{{ '}' }}'
{%- endfor %}
{%- endif %}

{%- if volumes %}
    volumes:
{%- for v in volumes %}
      - {{ v.placeholder.replace("@", "") if (render_mode is defined and render_mode in ("mkdocs", "deploy") and v.placeholder) else v.source.replace("/", "_").replace(".", "_").strip("_") }}: {{ v.path }}
{%- endfor %}
{%- endif %}

{%- if appjail and appjail.depends_on %}
{%- for dep in appjail.depends_on %}
  {{ dep.name }}:
    name: {{ dep.name | replace("-", "_") }}
    options:
      - from: {{ dep.image }}
{#- A sidecar needs a jail template too (host networking, jail params); its
    own when declared, else the stack's template.conf. #}
      - template: !ENV '${PWD}/{{ dep.template if dep.template else "template.conf" }}'
{%- if dep.env %}
    oci:
      environment:
{%- for k, v in dep.env.items() %}
{%- if v is string and v.startswith("!ENV") %}
        - {{ k }}: {{ v }}
{%- else %}
        - {{ k }}: "{{ v }}"
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if dep.volumes %}
    volumes:
{%- for k, v in dep.volumes.items() %}
      - {{ k }}: {{ v }}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}

{%- if volumes or (appjail and appjail.depends_on) %}
volumes:
{%- if volumes %}
{%- for v in volumes %}
  {{ v.placeholder.replace("@", "") if (render_mode is defined and render_mode in ("mkdocs", "deploy") and v.placeholder) else v.source.replace("/", "_").replace(".", "_").strip("_") }}:
{%- if render_mode is defined and render_mode == "deploy" %}
    device: !ENV '${{ '{' }}{{ v.placeholder.replace("@", "") }}{{ '}' }}'
{%- else %}
    device: '{% if v.root_var %}{{ cfg_root }}/{% endif %}{{ v.placeholder if (render_mode is defined and render_mode == "mkdocs" and v.placeholder) else v.source }}'
{%- endif %}
{%- endfor %}
{%- endif %}
{%- if appjail and appjail.depends_on %}
{%- for dep in appjail.depends_on %}
{%- if dep.volumes %}
{%- for vol_id, vol_path in dep.volumes.items() %}
  {{ vol_id }}:
    device: !ENV '${{ '{' }}{{ vol_id.upper() }}_LOCATION{{ '}' }}'
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endif %}
