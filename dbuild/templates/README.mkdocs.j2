{% extends "README.j2" %}
{#- GitHub alerts in the author's text become admonitions here (_site_alerts). #}
{%- set readme, notes = readme_site, notes_site %}

{#- What an option runs, before any YAML: the images, then the host folders
    the data lands in. Plain words; markdown, not a raw HTML block (a block
    inside a tab gets paragraph-wrapped and magiclink turns a placeholder's
    @ into a GitHub mention; a code span keeps it as text). #}
{#- The choices as one form: a card with a row of pills per choice, and
    under it one block of files per combination, all but the default hidden.
    deploy-choices.js on the site shows the block that matches the pills and
    keeps Podman and AppJail on the same answers. Markdown inside the HTML
    (md_in_html) so the fences keep their zip attributes.
    Past MAX_COMBOS ("merged"): every combination is rendered here, and
    choice_merge folds them into one block whose varying lines carry the
    picks that keep them; the script shows those. Combinations the merge
    cannot express follow it whole. #}
{#- A choice that is not for this runtime (runtimes: [podman]) gets no row
    here, and only the combinations with it at its default are listed, keyed
    without it: the script builds a form's key from its own rows. #}
{%- macro choice_form(runtime) -%}
{%- set shown = [] %}{% for c in choices if runtime in c.runtimes %}{% set _ = shown.append(c) %}{% endfor %}
{%- set merged = none %}
{%- if shown and choices_mode == "merged" %}
{%- set rendered = [] %}
{%- for cb in all_combos() if runtime in cb.runtimes %}{% set _ = rendered.append(combo_files(cb, runtime, true)) %}{% endfor %}
{%- set merged = choice_merge(rendered, runtime) %}
{%- endif %}
{%- if not shown %}
{{ combo_files(combos[0], runtime) }}
{% elif choices_capped[runtime] and not merged %}
{{ choices_capped[runtime] }}

{{ combo_files(combos[0], runtime) }}
{% else -%}
<div class="deploy-choices" data-app="{{ name }}" data-runtime="{{ runtime }}"{% if shown | selectattr("toggle") | list %} data-order="{{ shown | map(attribute='id') | join(' ') }}"{% endif %} markdown>
{% for c in shown if not c.toggle %}

**{{ c.label }}** {{ c.doc }}
{: .choice data-choice="{{ c.id }}" }

<div class="opts" data-choice="{{ c.id }}">{% for o in c.options %}<button type="button" data-option="{{ o.id }}"{% if o.default %} data-default aria-pressed="true"{% else %} aria-pressed="false"{% endif %}{% if o.doc %} title="{{ o.doc | replace('"', "'") }}"{% endif %}>{{ o.label }}</button>{% endfor %}</div>
{% endfor %}
{%- set toggles = shown | selectattr("toggle") | list %}
{%- if toggles %}

<div class="toggles">{% for c in toggles %}<button type="button" class="toggle" data-choice="{{ c.id }}" data-on="{{ c.toggle.on }}" data-off="{{ c.toggle.off }}" aria-pressed="true" title="{{ c.doc | replace('"', "'") }}"><span class="t-name">{{ c.label }}</span><span class="t-doc">{{ c.doc }}</span></button>{% endfor %}</div>
{%- if toggles | length > 3 %}
<p class="toggle-all"><button type="button" data-toggle-all="on">All</button><button type="button" data-toggle-all="off">None</button></p>
{%- endif %}
{%- endif %}

</div>
{%- if merged %}

<div class="deploy-merged" data-when="{{ merged.when }}" markdown>

{{ merged.markdown }}

</div>
{% for ex in merged.exceptions %}

<div class="deploy-combo" data-key="{{ ex.key }}" hidden markdown>

{{ ex.text }}

</div>
{% endfor %}
{%- else %}
{% for cb in combos if runtime in cb.runtimes %}

<div class="deploy-combo" data-key="{% for sel in cb.selections if runtime in sel.runtimes %}{{ sel.choice }}={{ sel.option }}{{ ";" if not loop.last }}{% endfor %}"{% if not cb.default %} hidden{% endif %} markdown>

{{ combo_files(cb, runtime) }}

</div>
{% endfor %}
{%- endif %}
{%- endif %}
{%- endmacro %}

{#- merged: one item per line (images, folders, option docs), so the merge
    can keep or drop each; one zip name whatever the picks. #}
