{%- macro you_get(o, parts, unit, merged=false) -%}
{%- if merged -%}
{%- for p in parts %}
<span class="yg">{% if p.kind == "none" %}your own {{ p.name | replace("your database", "database") }}{% else %}`{{ p.image }}`{% endif %}</span>
{%- endfor %}
{%- for f in o.folders %}
<span class="yf">`{{ f }}`</span>
