{% extends "README.j2" %}

{#- What an option runs, before any YAML: the images, then the host folders
    the data lands in. Plain words; markdown, not a raw HTML block (a block
    inside a tab gets paragraph-wrapped and magiclink turns a placeholder's
    @ into a GitHub mention; a code span keeps it as text). #}
{%- macro you_get(o, parts, unit) -%}
{%- set imgs = [] -%}
{%- for p in parts %}{% if p.kind == "none" %}{% set _ = imgs.append("your own " ~ p.name | replace("your database", "database")) %}{% else %}{% set _ = imgs.append("`" ~ p.image ~ "`") %}{% endif %}{% endfor -%}
{{ imgs | join(" · ") }}{% if o.folders %} — data in {% for f in o.folders %}`{{ f }}`{{ ", " if not loop.last }}{% endfor %}{% endif %}
{: .you-get }
{%- endmacro %}

{% block frontmatter -%}
---
title: "Run {{ title }} on FreeBSD — Native OCI Container"
description: "{{ description }} Built natively for FreeBSD with s6 supervision, PUID/PGID support, and CI-tested on every release."
---
{% endblock %}

{% block deprecation_notice -%}
{%- if deprecated %}
!!! danger "Deprecated"
    This image is no longer actively maintained or built.
{%- if deprecated.reason %}

    **Reason:** {{ deprecated.reason }}
{%- endif %}
{%- if deprecated.sunset_date %}

    **Sunset date:** {{ deprecated.sunset_date }}
{%- endif %}
{%- if deprecated.migration_guide %}

    **Migration:**

    {{ deprecated.migration_guide | indent(4) }}
{%- endif %}

{%- if deprecated.replacement %}
!!! tip "Use [{{ deprecated.replacement }}]({{ deprecated.replacement }}.md) instead"
    Migrate to **[{{ deprecated.replacement }}]({{ deprecated.replacement }}.md)**, which replaces this image.

{%- elif deprecated.successor %}
!!! tip "Successor"
    See **[{{ deprecated.successor }}]({{ deprecated.successor }})** for an alternative.

{% endif %}
{% endif %}
{%- endblock %}

{% block screenshots %}
{% if screenshots %}
<section class="splide screenshot-carousel" aria-label="{{ title }} screenshots">
  <div class="splide__track">
    <ul class="splide__list">
{% for shot in screenshots %}
      <li class="splide__slide">
        <a href="{{ shot }}" class="glightbox" data-gallery="{{ name }}">
          <img src="{{ shot }}" loading="lazy" alt="{{ title }} screenshot {{ loop.index }}">
        </a>
      </li>
{% endfor %}
    </ul>
  </div>
</section>
{% endif %}
{% endblock %}

{% block header_meta %}
| | |
|---|---|
{%- if ports %}
| :material-lan-connect: **Port** | `{{ ports[0].port }}` |
{%- endif %}
| :material-docker: **Registry** | [`{{ registry }}/{{ name }}`](https://github.com/daemonless/{{ name }}/pkgs/container/{{ name }}) |
| :fontawesome-brands-github: **Daemonless** | [daemonless/{{ name }}](https://github.com/daemonless/{{ name }}) |
| :material-code-tags: **Source** | [{{ upstream_url | replace('https://github.com/', '') | replace('https://', '') | truncate(40, true, '…') }}]({{ upstream_url }}) |
{%- if web_url %}
| :material-web: **Website** | [{{ web_url | replace('https://', '') | replace('http://', '') | trim('/') }}]({{ web_url }}) |
{%- endif %}
{% endblock %}

{% block prerequisites %}
{%- if readme and readme.prerequisites %}

{{ readme.prerequisites }}

{%- endif %}

Before deploying, ensure your host environment is ready. See the [Quick Start Guide](../guides/quick-start.md) for host setup instructions, including the security model for host vs. container privileges.
{% endblock %}

{% block deployment_tabs %}
{%- set port_var = "@" ~ name.upper().replace("-", "_") ~ "_PORT@" %}
{%- set bastille_tab = bastille_enabled and image_class == "service" %}
{%- if compose_text %}
{#- An app shipped with its database: the real compose and the .env it reads.
    The one-service snippet dropped the database; the one-container recipes
    (Bastille) would start the app without it. #}
=== ":podman-podman: Podman"
{% if choices %}
{% for c in choices %}
    **{{ c.label }}** {{ c.doc }}
    {: .deploy-choice }
{% for o in c.options %}
    === "{{ o.label }}"

        {{ you_get(o, o.parts, "container") | indent(8) }}

{% if o.doc %}
        {{ o.doc }}
{% endif %}
        **1.** Save as `.env`{% if o.ask %} and fill in {{ o.ask | map(attribute='label') | join(', ') }}{% else %} and fill in what is empty{% endif %}:

        ```env { data-zip-bundle="{{ o.zip }}" data-zip-filename=".env" }
        {{ o.example_env_site | trim | indent(8) }}
        ```

        **2.** Save as `compose.yaml`:

        ```yaml { data-zip-bundle="{{ o.zip }}" data-zip-filename="compose.yaml" }
        {{ o.compose_text_site | trim | indent(8) }}
        ```

        Then run `podman-compose up -d`.
{% endfor %}
{% endfor %}
{% elif example_env %}
    **1.** Save as `.env` and fill in what is empty:

    ```env { data-zip-bundle="{{ name }}-podman" data-zip-filename=".env" }
    {{ example_env_site | trim | indent(4) }}
    ```

    **2.** Save as `compose.yaml`:
{% endif %}
{% if not choices %}
    ```yaml { data-zip-bundle="{{ name }}-podman" data-zip-filename="compose.yaml" }
    {{ compose_text_site | trim | indent(4) }}
    ```

    Then run `podman-compose up -d`.
{% endif %}
{% if appjail_enabled and choices %}
=== ":appjail-appjail: AppJail"
{% for c in choices %}
    **{{ c.label }}** {{ c.doc }}
    {: .deploy-choice }
{% for o in c.options %}
    === "{{ o.label }}"

        {{ you_get(o, o.jails, "jail") | indent(8) }}

{% if o.doc %}
        {{ o.doc }}
{% endif %}
        {{ appjail_director_snippet(port_var, o) | indent(8) }}

        Save the files above, then run `appjail-director up`.
{% endfor %}
{% endfor %}
{% elif appjail_enabled and appjail_sidecar %}
=== ":appjail-appjail: AppJail"

    === ":material-file-document-outline: Director"

        {{ appjail_director_snippet(port_var) | indent(8) }}

        Save the files above, then run `appjail-director up`.
{% endif %}
{%- elif appjail_enabled or bastille_tab %}
{#- One tab per runtime, one way each. #}
=== ":podman-podman: Podman"
{% if image_class == "service" %}
    ```yaml { data-zip-bundle="{{ name }}-podman" data-zip-filename="compose.yaml" }
    {{ compose_snippet(port_var) | indent(4) }}
    ```

    Save as `compose.yaml`, then run `podman-compose up -d`.
{% elif docs is mapping and docs.usage %}
    {{ docs.usage | trim | indent(4) }}
{% else %}
    ```bash { data-zip-bundle="{{ name }}-podman-cli" data-zip-filename="run.sh" }
    {{ cli_snippet(port_var) | indent(4) }}
    ```

    Save as `run.sh`, then run `sh run.sh`.
{% endif %}
{% if appjail_enabled and image_class == "service" %}
=== ":appjail-appjail: AppJail"
{% if ports %}
    !!! warning
        Exposing ports in AppJail means that your service can be reached from remote hosts. If that is not your intention, do not expose the ports and communicate with the service using the jail's IPv4 address or hostname assigned by the virtual network.
{% endif %}
    {{ appjail_director_snippet(port_var) | indent(4) }}

    Save the files above, then run `appjail-director up`.
{% endif %}
{% if bastille_tab %}
=== ":bastille-bastille: Bastille"

    !!! warning "Experimental"
        Bastille's OCI support is experimental. It requires `buildah` and shares the host network stack (`inherit`). Mount volumes with `--volume HOST JAIL`; without it, image-declared volumes are stored under `${bastille_volumesdir}/${jail}`.
{% if choices %}
    Bastille runs one jail on the host's network stack, so it cannot add a database of its own: this is the default setup ({% for c in choices %}{{ c.label }} = {% for o in c.options if o.default %}{{ o.label }}{% endfor %}{{ ", " if not loop.last }}{% endfor %}). For another, point the app at a database you already run.
{% endif %}
    ```yaml { data-zip-bundle="{{ name }}-bastille" data-zip-filename="bastille-compose.yml" }
    {{ bastille_compose_snippet(port_var) | indent(4) }}
    ```

    Save as `bastille-compose.yml`, then run `bastille up`.
{% endif %}
{%- else %}
{#- Podman only: nothing to pick, so no tabs. #}
{% if image_class == "service" %}
```yaml { data-zip-bundle="{{ name }}-podman" data-zip-filename="compose.yaml" }
{{ compose_snippet(port_var) }}
```

Save as `compose.yaml`, then run `podman-compose up -d`.
{% elif docs is mapping and docs.usage %}
{{ docs.usage | trim }}
{% else %}
```bash { data-zip-bundle="{{ name }}-podman-cli" data-zip-filename="run.sh" }
{{ cli_snippet(port_var) }}
```

Save as `run.sh`, then run `sh run.sh`.
{% endif %}
{%- endif %}
{% endblock %}

{% block interactive_config %}
{#- The settings table lands under this heading (ux-settings-v2.js moves it
    here); without the heading it stays wherever the plugin drops it. Every
    page has at least the registry placeholder, a base image included, so
    every page gets the heading; an empty table hides itself. #}

### Interactive Configuration

<div class="placeholder-settings-panel"></div>
{% endblock %}

{% block implementation_details %}
!!! info "Implementation Details"

    - **Architectures:** {{ architectures | default(['amd64']) | join(', ') }}
    - **User:** `{{ user }}` (UID/GID set via [PUID/PGID](../guides/permissions.md)). Defaults to `1000:1000`.
    - **Base:** Built on `@REGISTRY@/base` (FreeBSD {{ base_version }}).
{%- if mlock %}
    - **mlock:** Requires `--annotation 'org.freebsd.jail.allow.mlock=true'` ([ocijail 0.5.0+](/guides/ocijail-patch/))
{%- endif %}
{%- if sysvipc %}
    - **sysvipc:** Requires `--annotation 'org.freebsd.jail.allow.sysvipc=true'` ([ocijail 0.5.0+](/guides/ocijail-patch/))
{%- endif %}
{% endblock %}

